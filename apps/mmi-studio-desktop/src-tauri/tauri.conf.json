{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Audi MMI Studio",
  "version": "0.1.0",
  "identifier": "com.audi.mmi.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Audi MMI Studio Workstation",
        "width": 1280,
        "height": 840,
        "minWidth": 800,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' 'unsafe-eval' data: blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Audi MMI 3G/3G+ Reverse Engineering Workstation",
    "longDescription": "Offline desktop workstation for Audi MMI 3G/3G+ firmware decoding, asset customization, navigation cartography, and SD card packaging."
  }
}
