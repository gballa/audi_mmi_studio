# ==============================================================================
# Audi MMI Studio — Environment Configuration Template (.env.example)
# ==============================================================================

# Enforce offline builds and testing across all Cargo invocations (default: true)
CARGO_NET_OFFLINE=true

# Workstation diagnostic logging level: trace, debug, info, warn, error (default: info)
RUST_LOG=info

# Directory for local workstation storage, CAS blobs, and staging workspaces (default: .mmistudio)
MMI_STUDIO_DIR=.mmistudio

# Directory containing reference Audi MMI 3G+ firmware packages (default: originals)
MMI_ORIGINALS_DIR=originals

# Route external AI generation through offline procedural mock provider (default: true)
MMI_OFFLINE_MOCK=true
